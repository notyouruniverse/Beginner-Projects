n = int(input("How many numbers do you wish to add?"))
list =[]

for i in range(n):
    element = int(input("Enter any number: "))
    list.append(element)
    
print("The unsorted list is: ", list)

def sort(list):
    for i in range(len(list)-1):
        if list[i] > list [i+1]:
            list[i], list[i+1] = list[i +1], list[i]
        return list
        
print("Sorted list is: ", sort(list))
